---
import { EXPERIENCE } from '../lib/site.ts';
const total = EXPERIENCE.length;
---

<!--
  Experience — editorial ledger / proof trail.
  Role is the dominant mass (that's the proof for a systems hire),
  company + period are amber mono meta, impact points read as a
  commit ledger with "+" markers. A single hairline spine connects rows.
-->
<section
  id="experience"
  aria-label="Professional experience"
  class="section-pad w-full"
>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-5 md:px-8">
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">// experience</p>
        <h2 class="display mt-3 text-3xl text-paper md:text-5xl">
          Where I've shipped
        </h2>
      </div>
      <p class="mono hidden text-xs uppercase tracking-wider text-dim sm:block">
        {String(total).padStart(2, '0')} roles
      </p>
    </div>

    <div class="relative">
      <!-- vertical spine -->
      <div
        aria-hidden="true"
        class="absolute inset-y-0 start-4 w-px bg-line md:start-0"
      ></div>

      <ol class="flex flex-col">
        {EXPERIENCE.map((item, index) => (
          <li
            class:list={[
              "relative flex flex-col gap-5 ps-12 md:ps-0",
              index < EXPERIENCE.length - 1 ? "pb-14" : "",
            ]}
          >
            <!-- spine node -->
            <span
              aria-hidden="true"
              class="absolute start-4 top-1.5 size-2 -translate-x-1/2 rounded-full border border-amber bg-ink md:start-0"
            ></span>

            <div
              class:list={[
                "grid w-full gap-5 md:grid-cols-12 md:gap-8",
                index % 2 === 1 ? "md:ps-14" : "",
              ]}
            >
              <!-- meta rail: index + period -->
              <div class="flex items-center justify-between gap-4 md:col-span-4 md:flex-col md:items-start md:gap-6 md:pt-1">
                <span class="mono text-xs tracking-widest text-amber">
                  {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
                </span>
                <time class="mono text-xs uppercase tracking-wider text-dim">
                  {item.period}
                </time>
              </div>

              <!-- content -->
              <div class="md:col-span-8">
                <h3 class="display text-2xl leading-tight text-paper md:text-4xl">
                  {item.role}
                </h3>
                <p class="mt-2 mono text-sm text-stone">
                  {item.company}
                  <span class="text-dim"> · {item.location}</span>
                </p>

                <p class="mt-4 max-w-2xl text-sm leading-relaxed text-paper/80">
                  {item.summary}
                </p>

                <ul class="mt-5 flex flex-col gap-3">
                  {item.points.map((point) => (
                    <li class="grid grid-cols-[auto_1fr] gap-3">
                      <span
                        aria-hidden="true"
                        class="mono mt-0.5 text-xs font-medium text-amber"
                      >
                        +
                      </span>
                      <p class="text-sm leading-relaxed text-paper/85">
                        {point}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>