---
import { SITE } from '../lib/site.ts';
const year = new Date().getFullYear();
---

<footer class="divider">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-5 py-10 md:flex-row md:items-center md:justify-between md:px-8">
    <div class="flex flex-col gap-1.5">
      <p class="mono text-sm text-paper">&gt;_ {SITE.name}</p>
      <p class="text-sm text-stone">{SITE.role}</p>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      {SITE.profiles.map((p) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mono text-xs uppercase tracking-wider text-stone transition-colors hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber motion-reduce:transition-none"
        >
          {p.label}
        </a>
      ))}
      {SITE.resumeUrl && (
        <a
          href={SITE.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mono text-xs uppercase tracking-wider rounded-md border border-amber px-3 py-1.5 text-amber transition-colors hover:bg-amber hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber motion-reduce:transition-none"
        >
          Résumé
        </a>
      )}
    </div>

    <p class="mono text-xs text-dim">
      © {year} {SITE.email}
      <span class="mx-1.5 text-line">/</span>
      <a href={SITE.url} class="transition-colors hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber motion-reduce:transition-none">{SITE.domain}</a>
    </p>
  </div>
</footer>