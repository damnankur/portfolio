---
import type { Project } from '../lib/supabase.ts';

export interface Props {
  projects?: Project[];
}

// Read projects passed in by the index page (which calls getProjects() in its
// frontmatter). Do NOT call getProjects() here — the prop is the intended API.
const { projects } = Astro.props;
const items: Project[] = projects ?? [];
const hasItems = items.length > 0;
const total = items.length;
---

<!--
  Projects.astro — editorial proof-trail ledger, matching Experience.
  No cards: a mono-indexed list on hairline rules. Title is the dominant
  mass, tech is inline mono, highlights use "+" markers like a commit log,
  featured projects carry a ★ marker, links are amber mono.
-->
<section id="projects" aria-label="Projects" class="section-pad w-full">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-5 md:px-8">
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow">// projects</p>
        <h2 class="display mt-3 text-3xl text-paper md:text-5xl">
          Things I've built
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-stone">
          Live from the Supabase CMS · deployed systems, not demos
        </p>
      </div>
      {hasItems && (
        <p class="mono hidden text-xs uppercase tracking-wider text-dim sm:block">
          {String(total).padStart(2, '0')} systems
        </p>
      )}
    </div>

    {hasItems ? (
      <ol class="flex flex-col">
        {items.map((project, index) => (
          <li
            class:list={[
              "group grid w-full gap-x-8 gap-y-3 border-line py-8 md:grid-cols-12",
              index < items.length - 1 ? "border-b" : "",
            ]}
          >
            <!-- index rail -->
            <div class="flex items-start gap-4 md:col-span-2">
              <span class="mono text-xs tracking-widest text-amber">
                {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
              </span>
            </div>

            <!-- content -->
            <div class="md:col-span-10">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                <h3 class="display text-2xl leading-tight text-paper transition-colors group-hover:text-amber-2 md:text-3xl motion-reduce:transition-none">
                  {project.title}
                </h3>
                {project.featured && (
                  <span class="mono text-xs tracking-wider text-amber" aria-label="Featured project">
                    ★ featured
                  </span>
                )}
              </div>

              <p class="mt-1.5 text-sm text-stone">
                {project.tagline}
              </p>

              <p class="mt-3 max-w-3xl text-sm leading-relaxed text-paper/80">
                {project.description}
              </p>

              <p class="mono mt-4 text-xs leading-relaxed text-dim">
                {(project.tech ?? []).join(' · ')}
              </p>

              <ul class="mt-4 flex flex-col gap-2.5">
                {(project.highlights ?? []).slice(0, 3).map((highlight) => (
                  <li class="grid grid-cols-[auto_1fr] gap-3">
                    <span
                      aria-hidden="true"
                      class="mono mt-0.5 text-xs font-medium text-amber"
                    >
                      +
                    </span>
                    <p class="text-sm leading-relaxed text-paper/85">
                      {highlight}
                    </p>
                  </li>
                ))}
              </ul>

              {(project.live_url || project.repo_url) && (
                <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
                  {project.live_url && (
                    <a
                      href={project.live_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mono text-xs uppercase tracking-wider text-amber transition-colors hover:text-amber-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber motion-reduce:transition-none"
                      aria-label={`Live site for ${project.title}`}
                    >
                      live ↗
                    </a>
                  )}
                  {project.repo_url && (
                    <a
                      href={project.repo_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mono text-xs uppercase tracking-wider text-stone underline decoration-amber/50 underline-offset-4 transition-colors hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber motion-reduce:transition-none"
                      aria-label={`Source code for ${project.title}`}
                    >
                      repo ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="mt-10 text-center text-stone">
        Projects loading from CMS
      </p>
    )}
  </div>
</section>